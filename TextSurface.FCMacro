from PySide import QtGui
import FreeCADGui, FreeCAD, Draft
from statistics import mean
import os

# --- Déterminer le chemin du fichier INI ---
# Chemin complet de la macro en cours
macro_fullpath = __file__
# Dossier contenant la macro
macro_path = os.path.dirname(macro_fullpath)
# Nom de la macro sans extension
macro_name = os.path.splitext(os.path.basename(macro_fullpath))[0]
# Chemin du fichier INI
ini_path = os.path.join(macro_path, macro_name + ".ini")


# --- Charger la police depuis le INI si présent ---
def loadFontFromIni(default_font):
    if os.path.exists(ini_path):
        try:
            with open(ini_path, "r", encoding="utf-8") as f:
                for line in f:
                    if line.startswith("font="):
                        font = line.split("=",1)[1].strip()
                        if os.path.exists(font):
                            return font
        except:
            pass
    return default_font

# --- Sauvegarder la police dans le INI ---
def saveFontToIni(font_path):
    try:
        with open(ini_path, "w", encoding="utf-8") as f:
            f.write("font=" + font_path)
    except:
        pass

# --- Déterminer la police par défaut selon OS ---
if os.name == 'nt':
    DefaultFont = "C:/Windows/Fonts/ARIAL.TTF"
elif os.name == 'posix':
    DefaultFont = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
else:
    DefaultFont = ""

# --- Charger police depuis INI ou défaut ---
FichierPoliceDeCaracteres = loadFontFromIni(DefaultFont)

# --- Vérification de la sélection ---
selEx = FreeCADGui.Selection.getSelectionEx()

if not selEx or not selEx[0].SubElementNames or not selEx[0].SubObjects:
    QtGui.QMessageBox.warning(
        None,
        "Sélection manquante",
        "Sélectionnez la face où vous souhaitez placer le texte avant de lancer la macro."
    )
else:

    selObj = selEx[0].Object
    nomFace = selEx[0].SubElementNames[0]

    TailleCaracteres = 4
    TextParDefaut = "Text"

    def findBodyOf(obj):
        while obj:
            if obj.TypeId == "PartDesign::Body":
                return obj
            obj = obj.getParentGeoFeatureGroup()
        return None

    bodyOfFace = findBodyOf(selObj)

    nouvelleShapeString = Draft.makeShapeString(
        String=TextParDefaut,
        FontFile=FichierPoliceDeCaracteres,
        Size=TailleCaracteres,
        Tracking=0.0
    )

    plm = FreeCAD.Placement()
    plm.Base = FreeCAD.Vector(0, 0, 0)
    plm.Rotation.Q = (0, 0, 0, 0)
    nouvelleShapeString.Placement = plm
    nouvelleShapeString.AttachmentSupport = None

    bodyOfFace.addObjects([nouvelleShapeString])
    FreeCAD.ActiveDocument.recompute()

    nouvelleShapeString.AttachmentOffset = FreeCAD.Placement(
        FreeCAD.Vector(0, 0, 0),
        FreeCAD.Rotation(0, 0, 0)
    )
    nouvelleShapeString.MapReversed = False
    nouvelleShapeString.AttachmentSupport = [(selObj, nomFace)]
    nouvelleShapeString.MapPathParameter = 0.0
    nouvelleShapeString.MapMode = 'InertialCS'
    nouvelleShapeString.Justification = u"Middle-Center"

    FreeCAD.ActiveDocument.recompute()

    class TextAdjustDialog(QtGui.QDialog):
        def __init__(self, shape):
            super(TextAdjustDialog, self).__init__()
            self.shape = shape
            self.setWindowTitle("Réglages du texte")

            layout = QtGui.QFormLayout()

            # --- Rotation ---
            self.rotSpin = QtGui.QDoubleSpinBox()
            self.rotSpin.setRange(-360, 360)
            self.rotSpin.setValue(0)
            layout.addRow("Rotation (° autour de la normale) :", self.rotSpin)

            # --- Taille du texte ---
            self.sizeSpin = QtGui.QDoubleSpinBox()
            self.sizeSpin.setRange(0.1, 500)
            self.sizeSpin.setDecimals(3)
            self.sizeSpin.setSingleStep(0.5)
            self.sizeSpin.setValue(shape.Size)
            layout.addRow("Taille du texte :", self.sizeSpin)

            # --- Police de caractères ---
            # --- Police de caractères ---
            self.fontEdit = QtGui.QLineEdit(FichierPoliceDeCaracteres)
            self.fontEdit.setMinimumWidth(300)

            self.fontBtn = QtGui.QPushButton("Choisir…")
            self.fontBtn.clicked.connect(self.chooseFont)

            fontLayout = QtGui.QHBoxLayout()
            fontLayout.addWidget(self.fontEdit)
            fontLayout.addWidget(self.fontBtn)
            layout.addRow("Police :", fontLayout)

            # --- Miroir ---
            self.mirrorCheck = QtGui.QCheckBox("Miroir (MapReversed)")
            self.mirrorCheck.setChecked(shape.MapReversed)
            layout.addRow(self.mirrorCheck)

            # --- Offsets ---
            self.xSpin = QtGui.QDoubleSpinBox()
            self.ySpin = QtGui.QDoubleSpinBox()
            self.zSpin = QtGui.QDoubleSpinBox()
            for spin in (self.xSpin, self.ySpin, self.zSpin):
                spin.setRange(-1000, 1000)
                spin.setDecimals(3)

            self.xSpin.setValue(shape.AttachmentOffset.Base.x)
            self.ySpin.setValue(shape.AttachmentOffset.Base.y)
            self.zSpin.setValue(shape.AttachmentOffset.Base.z)

            layout.addRow("Offset X :", self.xSpin)
            layout.addRow("Offset Y :", self.ySpin)
            layout.addRow("Offset Z :", self.zSpin)

            # --- Boutons ---
            btnLayout = QtGui.QHBoxLayout()
            applyBtn = QtGui.QPushButton("Appliquer")
            closeBtn = QtGui.QPushButton("Fermer")
            btnLayout.addWidget(applyBtn)
            btnLayout.addWidget(closeBtn)
            layout.addRow(btnLayout)

            applyBtn.clicked.connect(self.applyChanges)
            closeBtn.clicked.connect(self.close)

            self.setLayout(layout)

        def chooseFont(self):
            # Sélecteur sans chemin imposé (évite les restrictions Windows)
            font_path, _ = QtGui.QFileDialog.getOpenFileName(
                self,
                "Choisir une police TrueType",
                "",
                "Polices (*.ttf *.otf);;Tous les fichiers (*.*)"
            )

            if font_path:
                # Mise à jour du champ texte
                self.fontEdit.setText(font_path)

                # Sauvegarde dans le fichier INI
                saveFontToIni(font_path)

                # Mise à jour du ShapeString
                self.shape.FontFile = font_path

                FreeCAD.ActiveDocument.recompute()

        def applyChanges(self):
            # Rotation
            angle = self.rotSpin.value()
            rot = FreeCAD.Rotation(FreeCAD.Vector(0, 0, 1), angle)
            self.shape.AttachmentOffset.Rotation = rot

            # Taille du texte
            self.shape.Size = self.sizeSpin.value()

            # Police (si modifiée)
            font_path = self.fontEdit.text().strip()
            if font_path:
                self.shape.FontFile = font_path
                saveFontToIni(font_path)

            # Miroir
            self.shape.MapReversed = self.mirrorCheck.isChecked()

            # Offsets
            self.shape.AttachmentOffset.Base = FreeCAD.Vector(
                self.xSpin.value(),
                self.ySpin.value(),
                self.zSpin.value()
            )

            FreeCAD.ActiveDocument.recompute()

    dlg = TextAdjustDialog(nouvelleShapeString)
    dlg.exec()
